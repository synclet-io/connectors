{
  "streams": [
    {
      "stream": {
        "name": "events",
        "json_schema": {"type": "object", "properties": {"id": {"type": "integer"}, "kind": {"type": "string"}, "payload": {"type": "object"}}},
        "supported_sync_modes": ["full_refresh", "incremental"]
      },
      "sync_mode": "incremental",
      "destination_sync_mode": "append",
      "cursor_field": ["id"]
    },
    {
      "stream": {
        "name": "users",
        "json_schema": {"type": "object", "properties": {"id": {"type": "integer"}, "name": {"type": "string"}, "updated_at": {"type": "string", "format": "date-time"}}},
        "supported_sync_modes": ["full_refresh", "incremental"],
        "source_defined_primary_key": [["id"]]
      },
      "sync_mode": "incremental",
      "destination_sync_mode": "append_dedup",
      "primary_key": [["id"]],
      "cursor_field": ["updated_at"]
    },
    {
      "stream": {
        "name": "rates",
        "json_schema": {"type": "object", "properties": {"code": {"type": "string"}, "rate": {"type": "number"}, "day": {"type": "string", "format": "date"}}},
        "supported_sync_modes": ["full_refresh"]
      },
      "sync_mode": "full_refresh",
      "destination_sync_mode": "overwrite"
    }
  ]
}
