{
  "streams": [
    {
      "stream": {"name": "events", "json_schema": {"type": "object", "properties": {"id": {"type": "integer"}, "kind": {"type": "string"}}}},
      "sync_mode": "incremental",
      "cursor_field": ["id"],
      "destination_sync_mode": "append"
    },
    {
      "stream": {"name": "users", "json_schema": {"type": "object", "properties": {"id": {"type": "integer"}, "name": {"type": "string"}, "updated_at": {"type": "string", "format": "date-time"}}}},
      "sync_mode": "incremental",
      "cursor_field": ["updated_at"],
      "destination_sync_mode": "append_dedup",
      "primary_key": [["id"]]
    },
    {
      "stream": {"name": "rates", "json_schema": {"type": "object", "properties": {"code": {"type": "string"}, "rate": {"type": "number"}}}},
      "sync_mode": "full_refresh",
      "destination_sync_mode": "overwrite"
    }
  ]
}
