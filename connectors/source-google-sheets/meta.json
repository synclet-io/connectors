{
  "$schema": "../../schema/meta.schema.json",
  "name": "Google Sheets",
  "connector_type": "source",
  "version": "0.4.1",
  "release_stage": "alpha",
  "support_level": "community",
  "source_type": "api",
  "license": "MIT",
  "documentation_url": "https://github.com/synclet-io/connectors/tree/main/connectors/source-google-sheets",
  "icon_url": "",
  "language": "go",
  "tags": [
    "google",
    "spreadsheet"
  ],
  "allowed_hosts": [
    "sheets.googleapis.com",
    "www.googleapis.com",
    "oauth2.googleapis.com"
  ],
  "breaking_changes": {
    "0.4.0": {
      "message": "A sync now fails, asking to refresh the source schema, when a configured column is no longer in the sheet's header, or when two columns get the same name after names_conversion; 0.3.0 kept syncing without the column or kept one of the two values. Refresh the source schema after changing a header."
    }
  },
  "external_documentation_urls": [],
  "api_versions": [
    {
      "api": "Google Sheets API",
      "pinned": "v4",
      "file": "client.go",
      "pattern": "\"/(v\\d+)/spreadsheets/",
      "checker": "google-discovery",
      "params": {
        "api": "sheets"
      },
      "docs": "https://developers.google.com/workspace/sheets/api/reference/rest"
    },
    {
      "api": "Google Drive API",
      "pinned": "v3",
      "file": "client.go",
      "pattern": "\"/drive/(v\\d+)/",
      "checker": "google-discovery",
      "params": {
        "api": "drive"
      },
      "docs": "https://developers.google.com/workspace/drive/api/reference/rest/v3"
    }
  ]
}
