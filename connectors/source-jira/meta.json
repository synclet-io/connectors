{
  "$schema": "../../schema/meta.schema.json",
  "name": "Jira",
  "connector_type": "source",
  "version": "0.1.0",
  "release_stage": "alpha",
  "support_level": "community",
  "source_type": "api",
  "license": "MIT",
  "documentation_url": "https://github.com/synclet-io/connectors/tree/main/connectors/source-jira",
  "icon_url": "",
  "language": "declarative",
  "tags": [
    "api",
    "declarative",
    "project-management"
  ],
  "allowed_hosts": [
    "${domain}"
  ],
  "breaking_changes": {},
  "external_documentation_urls": [],
  "api_versions": [
    {
      "api": "Jira Cloud REST API",
      "pinned": "3",
      "file": "manifest.yaml",
      "pattern": "path: api/(\\d+)/",
      "checker": "none",
      "docs": "https://developer.atlassian.com/cloud/jira/platform/rest/v3/intro/"
    },
    {
      "api": "Jira Software Cloud REST API",
      "pinned": "1.0",
      "file": "manifest.yaml",
      "pattern": "path: agile/([\\d.]+)/",
      "checker": "none",
      "docs": "https://developer.atlassian.com/cloud/jira/software/rest/intro/"
    }
  ]
}
