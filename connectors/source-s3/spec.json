{
  "changelogUrl": "",
  "connectionSpecification": {
    "description": "Reads CSV, TSV, JSONL and Parquet files from S3-compatible storage, one stream per glob: full refresh, or incremental by object modification time.",
    "properties": {
      "bucket": {
        "description": "Name of the bucket.",
        "order": 0,
        "title": "Bucket",
        "type": "string"
      },
      "credentials": {
        "description": "How requests are signed.",
        "oneOf": [
          {
            "description": "A static access key.",
            "properties": {
              "access_key_id": {
                "airbyte_secret": true,
                "description": "Access key ID of the IAM user or the S3-compatible service.",
                "order": 1,
                "title": "Access Key ID",
                "type": "string"
              },
              "auth_type": {
                "const": "access_key",
                "order": 0,
                "type": "string"
              },
              "secret_access_key": {
                "airbyte_secret": true,
                "description": "Secret of the access key.",
                "order": 2,
                "title": "Secret Access Key",
                "type": "string"
              }
            },
            "required": [
              "auth_type",
              "access_key_id",
              "secret_access_key"
            ],
            "title": "Access Key",
            "type": "object"
          },
          {
            "description": "The AWS SDK default chain: environment variables, shared config files, web identity (EKS IRSA), ECS task role or EC2 instance profile.",
            "properties": {
              "auth_type": {
                "const": "default_chain",
                "order": 0,
                "type": "string"
              }
            },
            "required": [
              "auth_type"
            ],
            "title": "Default Credential Chain",
            "type": "object"
          },
          {
            "description": "Assumes an IAM role through STS. The call is signed with the access key when one is given, with the default credential chain otherwise.",
            "properties": {
              "access_key_id": {
                "airbyte_secret": true,
                "description": "Access key ID of the IAM user or the S3-compatible service.",
                "order": 4,
                "title": "Access Key ID",
                "type": "string"
              },
              "auth_type": {
                "const": "assume_role",
                "order": 0,
                "type": "string"
              },
              "external_id": {
                "airbyte_secret": true,
                "description": "External ID the role's trust policy requires, if any.",
                "order": 2,
                "title": "External ID",
                "type": "string"
              },
              "role_arn": {
                "description": "ARN of the role to assume.",
                "examples": [
                  "arn:aws:iam::123456789012:role/synclet-reader"
                ],
                "order": 1,
                "title": "Role ARN",
                "type": "string"
              },
              "role_session_name": {
                "default": "synclet-source-s3",
                "description": "Session name recorded in CloudTrail.",
                "order": 3,
                "title": "Role Session Name",
                "type": "string"
              },
              "secret_access_key": {
                "airbyte_secret": true,
                "description": "Secret of the access key.",
                "order": 5,
                "title": "Secret Access Key",
                "type": "string"
              }
            },
            "required": [
              "auth_type",
              "role_arn"
            ],
            "title": "Assume Role",
            "type": "object"
          }
        ],
        "order": 4,
        "title": "Credentials",
        "type": "object"
      },
      "endpoint": {
        "description": "Endpoint of an S3-compatible service (MinIO, Cloudflare R2, ...). Empty: AWS S3.",
        "examples": [
          "https://<account>.r2.cloudflarestorage.com",
          "http://minio:9000"
        ],
        "order": 2,
        "title": "Endpoint",
        "type": "string"
      },
      "force_path_style": {
        "default": false,
        "description": "Address the bucket as endpoint/bucket instead of bucket.endpoint, as MinIO usually needs.",
        "order": 3,
        "title": "Path-Style Addressing",
        "type": "boolean"
      },
      "region": {
        "default": "us-east-1",
        "description": "Region of the bucket.",
        "order": 1,
        "title": "Region",
        "type": "string"
      },
      "streams": {
        "description": "One stream per glob.",
        "items": {
          "properties": {
            "compression": {
              "default": "auto",
              "description": "auto: by the key's extension (.gz, .zst), then by the first bytes; none, gzip or zstd: always that.",
              "enum": [
                "auto",
                "none",
                "gzip",
                "zstd"
              ],
              "order": 3,
              "title": "Compression",
              "type": "string"
            },
            "format": {
              "description": "File format of the stream's objects.",
              "oneOf": [
                {
                  "description": "Delimited text with a header row; values with the delimiter, quotes or line breaks are quoted.",
                  "properties": {
                    "column_names": {
                      "description": "Column names in file order. Required without a header row; with one they replace its names.",
                      "items": {
                        "type": "string"
                      },
                      "order": 5,
                      "title": "Column Names",
                      "type": "array"
                    },
                    "delimiter": {
                      "default": ",",
                      "description": "Character between fields.",
                      "order": 1,
                      "title": "Delimiter",
                      "type": "string"
                    },
                    "escape_char": {
                      "default": "",
                      "description": "Character that makes the next character literal, inside or outside quotes. Empty: none.",
                      "order": 3,
                      "title": "Escape Character",
                      "type": "string"
                    },
                    "filetype": {
                      "const": "csv",
                      "order": 0,
                      "type": "string"
                    },
                    "header": {
                      "default": true,
                      "description": "Whether the first row (after skip_rows) names the columns.",
                      "order": 4,
                      "title": "Header Row",
                      "type": "boolean"
                    },
                    "null_values": {
                      "default": [
                        ""
                      ],
                      "description": "Unquoted values read as null. A quoted value is never null.",
                      "items": {
                        "type": "string"
                      },
                      "order": 7,
                      "title": "Null Values",
                      "type": "array"
                    },
                    "quote_char": {
                      "default": "\"",
                      "description": "Character that quotes a field holding the delimiter, line breaks or quotes; a doubled quote inside stands for one. Empty: fields are never quoted.",
                      "order": 2,
                      "title": "Quote Character",
                      "type": "string"
                    },
                    "skip_rows": {
                      "default": 0,
                      "description": "Lines to skip at the start of each file, before the header.",
                      "order": 6,
                      "title": "Skip Rows",
                      "type": "integer"
                    }
                  },
                  "required": [
                    "filetype"
                  ],
                  "title": "CSV",
                  "type": "object"
                },
                {
                  "description": "Tab-separated text; by default no quoting, so a field holds no tab or line break.",
                  "properties": {
                    "column_names": {
                      "description": "Column names in file order. Required without a header row; with one they replace its names.",
                      "items": {
                        "type": "string"
                      },
                      "order": 5,
                      "title": "Column Names",
                      "type": "array"
                    },
                    "delimiter": {
                      "default": "\t",
                      "description": "Character between fields.",
                      "order": 1,
                      "title": "Delimiter",
                      "type": "string"
                    },
                    "escape_char": {
                      "default": "",
                      "description": "Character that makes the next character literal, inside or outside quotes. Empty: none.",
                      "order": 3,
                      "title": "Escape Character",
                      "type": "string"
                    },
                    "filetype": {
                      "const": "tsv",
                      "order": 0,
                      "type": "string"
                    },
                    "header": {
                      "default": true,
                      "description": "Whether the first row (after skip_rows) names the columns.",
                      "order": 4,
                      "title": "Header Row",
                      "type": "boolean"
                    },
                    "null_values": {
                      "default": [
                        ""
                      ],
                      "description": "Unquoted values read as null. A quoted value is never null.",
                      "items": {
                        "type": "string"
                      },
                      "order": 7,
                      "title": "Null Values",
                      "type": "array"
                    },
                    "quote_char": {
                      "default": "",
                      "description": "Character that quotes a field holding the delimiter, line breaks or quotes; a doubled quote inside stands for one. Empty: fields are never quoted.",
                      "order": 2,
                      "title": "Quote Character",
                      "type": "string"
                    },
                    "skip_rows": {
                      "default": 0,
                      "description": "Lines to skip at the start of each file, before the header.",
                      "order": 6,
                      "title": "Skip Rows",
                      "type": "integer"
                    }
                  },
                  "required": [
                    "filetype"
                  ],
                  "title": "TSV",
                  "type": "object"
                },
                {
                  "description": "One JSON object per line.",
                  "properties": {
                    "filetype": {
                      "const": "jsonl",
                      "order": 0,
                      "type": "string"
                    }
                  },
                  "required": [
                    "filetype"
                  ],
                  "title": "JSONL",
                  "type": "object"
                },
                {
                  "description": "Apache Parquet files.",
                  "properties": {
                    "filetype": {
                      "const": "parquet",
                      "order": 0,
                      "type": "string"
                    }
                  },
                  "required": [
                    "filetype"
                  ],
                  "title": "Parquet",
                  "type": "object"
                }
              ],
              "order": 2,
              "title": "Format",
              "type": "object"
            },
            "glob": {
              "description": "Object keys the stream reads: * matches within one path segment, ** across segments, ? one character, {a,b} alternatives. The part before the first wildcard is the listing prefix.",
              "examples": [
                "exports/**/*.csv",
                "events/2026-*/part-*.parquet"
              ],
              "order": 1,
              "title": "Glob",
              "type": "string"
            },
            "name": {
              "description": "Stream name.",
              "order": 0,
              "title": "Name",
              "type": "string"
            },
            "schema": {
              "description": "JSON schema of the records, an object schema with properties. Empty: inferred from the newest files.",
              "examples": [
                "{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"integer\"},\"name\":{\"type\":[\"null\",\"string\"]}}}"
              ],
              "order": 4,
              "title": "Schema",
              "type": "string"
            },
            "schema_sample_files": {
              "default": 10,
              "description": "How many of the newest matching files the schema is inferred from.",
              "order": 5,
              "title": "Schema Sample Files",
              "type": "integer"
            },
            "skip_bad_rows": {
              "default": false,
              "description": "Skip rows that cannot be parsed or do not fit the schema, and log how many per file, instead of failing the read.",
              "order": 6,
              "title": "Skip Bad Rows",
              "type": "boolean"
            }
          },
          "required": [
            "name",
            "glob",
            "format"
          ],
          "title": "Stream",
          "type": "object"
        },
        "order": 5,
        "title": "Streams",
        "type": "array"
      }
    },
    "required": [
      "bucket",
      "credentials",
      "streams"
    ],
    "title": "S3 Source Spec",
    "type": "object"
  },
  "documentationUrl": "https://github.com/synclet-io/connectors/tree/main/connectors/source-s3",
  "protocol_version": "0.5.2",
  "supported_destination_sync_modes": [
    "overwrite",
    "append",
    "append_dedup"
  ],
  "supportsDBT": false,
  "supportsIncremental": true,
  "supportsNormalization": false
}
